{
  "name": "svelte-ascii-ui",
  "version": "0.1.0",
  "author": {
    "name": "Igor Lopatinskii",
    "url": "https://github.com/IgorLo"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IgorLo/svelte-ascii-ui.git"
  },
  "homepage": "https://github.com/IgorLo/svelte-ascii-ui#readme",
  "bugs": {
    "url": "https://github.com/IgorLo/svelte-ascii-ui/issues"
  },
  "keywords": [
    "svelte",
    "svelte5",
    "ascii",
    "ui-kit",
    "components",
    "design-system",
    "terminal"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:lib",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "build:demo": "vite build --outDir demo-dist",
    "build:lib": "svelte-package",
    "storybook": "storybook dev -p 6006 --no-open",
    "build:storybook": "storybook build",
    "test": "npm run test:unit && npm run test:browser && npm run test:browser:choice-touch",
    "test:unit": "node --experimental-strip-types --test bench/frame-loop.test.mjs bench/sine-pattern.test.mjs tests/release-policy.test.mjs tests/changesets.test.mjs",
    "check:release": "node scripts/check-release.mjs",
    "release:notes": "node scripts/check-release.mjs --notes",
    "test:browser": "vitest run",
    "test:browser:choice-touch": "vitest run --config vitest.choice-touch.config.ts",
    "test:package": "node scripts/check-package.mjs",
    "prepack": "npm run check:release && npm run build:lib",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "check:changesets": "node scripts/check-changesets.mjs",
    "release:version": "npm run check:changesets && changeset version && npm install --package-lock-only --ignore-scripts"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@changesets/get-release-plan": "^5.0.2",
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/svelte-vite": "^10.6.6",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@testing-library/svelte": "^5.4.2",
    "@vitest/browser-playwright": "^5.1.0",
    "playwright": "^1.65.0",
    "storybook": "^10.6.6",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.1.0"
  },
  "description": "Just a fun stylish vibecoded ASCII-like ui-kit for svelte",
  "files": [
    "dist",
    "CHANGELOG.md",
    "docs/agents",
    "docs/design-system.md",
    "docs/components.md",
    "docs/composition.md"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/theme.css",
    "./fonts.css": "./dist/fonts.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "svelte": "^5.57.0"
  },
  "engines": {
    "node": ">=22.19"
  }
}
