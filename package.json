{
  "name": "svelte-ascii-ui",
  "version": "0.1.0",
  "author": {
    "name": "Igor Lopatinskii",
    "url": "https://github.com/IgorLo"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IgorLo/svelte-ascii-ui.git"
  },
  "homepage": "https://github.com/IgorLo/svelte-ascii-ui#readme",
  "bugs": {
    "url": "https://github.com/IgorLo/svelte-ascii-ui/issues"
  },
  "keywords": ["svelte", "svelte5", "ascii", "ui-kit", "components", "design-system", "terminal"],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:lib",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "build:demo": "vite build --outDir demo-dist",
    "build:lib": "svelte-package",
    "storybook": "storybook dev -p 6006 --no-open",
    "build:storybook": "storybook build",
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "node --experimental-strip-types --test bench/frame-loop.test.mjs bench/sine-pattern.test.mjs",
    "test:browser": "vitest run",
    "test:package": "node scripts/check-package.mjs",
    "prepack": "npm run build:lib"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/svelte-vite": "^10.6.6",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@vitest/browser-playwright": "^5.1.0",
    "playwright": "^1.65.0",
    "storybook": "^10.6.6",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.1.0",
    "@fontsource-variable/cascadia-code": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/dotgothic16": "^5.3.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/pt-mono": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0"
  },
  "description": "Just a fun stylish vibecoded ASCII-like ui-kit for svelte",
  "files": [
    "dist",
    "docs/agents",
    "docs/design-system.md",
    "docs/components.md"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/theme.css",
    "./fonts.css": "./dist/fonts.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "svelte": "^5.57.0"
  },
  "engines": {
    "node": ">=22.19"
  }
}
